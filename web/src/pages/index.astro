---
// base 경로 뒤에 파일 이름을 안전하게 잇는다. BASE_URL 끝의 슬래시 유무에
// 관계없이 정확히 하나만 남긴다.
const base = (file) => `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/${file}`;

import "../styles/tokens.css";
import Sidebar from "../components/Sidebar.astro";
import Tabs from "../components/Tabs.astro";
import CopyField from "../components/CopyField.astro";
import Icon from "../components/Icon.astro";
import ModCard from "../components/ModCard.astro";
import Callout from "../components/Callout.astro";
import PageHead from "../components/PageHead.astro";
import Hi from "../components/Hi.astro";
import Shot from "../components/Shot.astro";

// r2modman 창을 그대로 보여주는 자리는 실제 화면 사진(Shot)을 쓴다. 손으로
// 그린 도식은 사진으로 대신할 수 없는 것만 남겼다. 전체 흐름, 어디서 켜느냐에
// 따른 결과 차이, 버전이 어긋났을 때 벌어지는 일이 그것이다.
import DiagramFlow from "../components/diagrams/DiagramFlow.astro";
import DiagramLaunch from "../components/diagrams/DiagramLaunch.astro";
import { SERVER } from "../config.mjs";
import { formatChangeDate, summarizeChanges } from "../lib/modpack-changes.mjs";
import modsData from "../../../data/mods.json";

const TABS = [
  { id: "server", label: "서버", icon: "home-01" },
  { id: "mods", label: "모드", icon: "package-02" },
  { id: "install", label: "설치 가이드", icon: "download-04" },
  { id: "dex", label: "도감", icon: "book-open-01" },
  { id: "world", label: "월드", icon: "globe-02" },
];

// 계층은 친구가 할 일로 나뉜다.
//   3층 전원 필수 / 2층 원하면 설치 / 1층 서버 전용
// 개수는 전부 data/mods.json 에서 세어 쓴다. 숫자를 손으로 적지 않는다.
const tier1 = modsData.mods.filter((m) => m.tier === 1);
const tier2 = modsData.mods.filter((m) => m.tier === 2);
const tier3 = modsData.mods.filter((m) => m.tier === 3);
const modpackCode = modsData.modpack.r2modmanCode;

// r2modman 이 그대로 읽는 프로필 파일이다. scripts/build-modpack.mjs 가
// data/mods.json 에서 만들어 web/public/ 에 놓는다. 여기 적는 이름은 그
// 스크립트의 출력 파일 이름과 같아야 한다.
//
// base() 를 거치지 않고 "/gaybar-modpack.r2z" 로 쓰면 배포본에서 404 가 난다.
// 사이트가 /valheim-multi/ 아래에 놓이기 때문이다.
const MODPACK_FILE = "gaybar-modpack.r2z";
const modpackDepCount = modsData.modpack.dependencies.length;

// 프로필을 가져온 뒤 r2modman 왼쪽에 뜨는 "Installed" 숫자다. 이 숫자가
// 맞으면 빠진 것이 없다는 뜻이라, 친구가 스스로 확인할 수 있는 유일한
// 신호다. scripts/build-modpack.mjs 가 의존성 + 3층 + 2층을 담으므로
// 여기서도 같은 식으로 센다. 손으로 적으면 모드가 늘 때 어긋난다.
const modpackPackageCount = modpackDepCount + tier3.length + tier2.length;

// 화면 문구는 data/mods.json 의 내용에 따라 저절로 달라진다.
// 3층(직접 설치) 모드가 하나라도 있으면 "설치할 것이 있다" 로,
// 없으면 "지금은 없다" 로 읽힌다. 모드가 추가될 때 이 파일을 다시
// 고칠 필요가 없어야 한다.
const needsAnyInstall = tier3.length > 0;

// 모드팩이 언제 무엇 때문에 바뀌었는지다.
//
// 친구 입장에서 "내가 파일을 다시 받아야 하나" 를 스스로 판단할 근거가
// 이것뿐이다. 서버는 친구 PC 에 무엇이 깔려 있는지 알 수 없으므로 화면이
// 개인별로 "당신은 업데이트가 필요합니다" 라고 말해 줄 방법이 없다.
// 그래서 갱신 날짜를 보여주고, 그보다 전에 받았으면 다시 받으라고 한다.
const { latest: latestChange, mustUpdate, older: olderChanges } = summarizeChanges(
  modsData.modpack.changes,
);

// 설치 가이드는 한 화면에 한 단계씩 보여준다.
// 여기 순서가 진행 표시와 화면 순서를 함께 정한다.
// 마지막 칸은 단계가 아니라 끝났다는 것을 알리는 화면이다.
const STEPS = [
  { n: 1, label: "r2modman 설치" },
  { n: 2, label: "발헤임 고르기" },
  { n: 3, label: "파일 받기" },
  { n: 4, label: "가져오기" },
  { n: 5, label: "프로필 고르기" },
  { n: 6, label: "Start modded" },
  { n: 7, label: "서버 접속" },
  { n: 8, label: "완료" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      검색엔진 색인을 막는다. 저장소는 비공개지만 GitHub Pages 로 배포되면
      사이트 자체는 공개적으로 접근 가능해지고, 이 페이지에는 서버 접속
      주소와 비밀번호가 그대로 담겨 있다. 이 태그는 검색엔진 수집만
      막을 뿐, 주소를 이미 아는 사람의 접근을 막지는 못한다. 자세한 내용은
      docs/guides/github-pages-deploy.md 를 본다.
    -->
    <meta name="robots" content="noindex, nofollow" />

    {/* 파비콘은 base 경로를 붙여서 가리킨다. 프로젝트 Pages 라 사이트가
        /valheim-multi/ 아래에 놓이는데, 링크가 없으면 브라우저가 오리진
        루트의 /favicon.ico 를 찾다가 404 를 낸다.

        BASE_URL 은 설정에 따라 끝에 슬래시가 있을 수도 없을 수도 있다.
        그냥 이어 붙이면 /valheim-multifavicon.svg 가 된다. 실제로 겪었다. */}
    <link rel="icon" href={base("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={base("favicon.ico")} sizes="any" />

    <title>gaybar 서버</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.20/index.min.css"
    />
  </head>
  <body>
    <div class="shell">
      {TABS.map((t, i) => (
        <input
          type="radio"
          name="tab"
          id={`tab-${t.id}`}
          class="tab-radio sr-only"
          checked={i === 0}
        />
      ))}

      <Tabs tabs={TABS}>
        <div slot="server">
          <PageHead
            kicker="발헤임 전용 서버"
            title="gaybar"
            icon="home-01"
            desc="주소와 비밀번호만 있으면 들어올 수 있습니다. 설치할 모드가 있는지는 모드 탭에서 확인하세요."
          >
            <div class="status-pill" slot="aside">
              <p class="badge" id="status-badge" data-state="unknown" aria-live="polite" aria-atomic="true">상태 확인 중</p>
              <p class="age" id="status-age"></p>
            </div>
          </PageHead>

          <div class="cols cols-wide">
            <section class="block">
              {/*
                모드팩이 바뀌었는지 알리는 자리다. 접속 정보보다 위에 둔다.
                버전이 어긋나면 주소와 비밀번호가 맞아도 들어오지 못하므로
                순서상 이쪽이 먼저다.

                이력이 없으면 통째로 감춘다. 한 번도 갱신하지 않았다면
                알릴 것이 없고, 빈 카드는 읽을거리만 늘린다.
              */}
              {latestChange && (
                <div class="upd" data-hot={mustUpdate}>
                  <h2 class="block-h">
                    <Icon name="system-update-01" size={17} />
                    모드팩 갱신
                  </h2>

                  <div class="card upd-card">
                    <p class="upd-verdict">
                      <Icon name={mustUpdate ? "alert-diamond" : "checkmark-circle-02"} size={18} />
                      {mustUpdate
                        ? "파일을 다시 받아야 합니다"
                        : "다시 받지 않아도 됩니다"}
                    </p>

                    <p class="upd-sum">{latestChange.summary}</p>

                    <p class="upd-when">
                      <Icon name="clock-01" size={15} />
                      <span>
                        {/* time 태그와 조사 "에" 사이에 줄바꿈을 두면 JSX 가
                            그것을 공백으로 바꿔 "19일 에" 로 렌더된다.
                            조사는 앞말에 붙어야 하므로 한 줄로 쓴다. */}
                        <time datetime={latestChange.date}>{formatChangeDate(latestChange.date)}</time>에 바뀌었습니다.{" "}
                        {mustUpdate
                          ? "그 전에 프로필을 받으셨다면 지금 다시 받으세요."
                          : "이 변경은 서버에서만 처리되어 친구들이 할 일은 없습니다."}
                      </span>
                    </p>

                    {mustUpdate && (
                      <label class="upd-go" for="tab-install">
                        업데이트하는 방법 보기
                        <Icon name="arrow-right-02" size={17} />
                      </label>
                    )}

                    {/*
                      지난 이력은 접어 둔다. 지금 무엇을 해야 하는지가
                      먼저고, 옛날 기록은 궁금한 사람만 편다.
                    */}
                    {olderChanges.length > 0 && (
                      <details class="upd-log">
                        <summary>지난 변경 {olderChanges.length}건</summary>
                        <ul>
                          {olderChanges.map((c) => (
                            <li>
                              <time datetime={c.date}>{formatChangeDate(c.date)}</time>
                              <span>{c.summary}</span>
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </div>
                </div>
              )}

              <h2 class="block-h">
                <Icon name="key-01" size={17} />
                접속 정보
              </h2>
              <div class="card card-lead">
                <CopyField label="주소" value={SERVER.address} mono id="server-address" />
                <CopyField label="비밀번호" value={SERVER.password} masked />
              </div>
            </section>

            <aside class="block">
              <h2 class="block-h">
                <Icon name="user-group" size={17} />
                지금 서버
              </h2>

              <div class="card side-card">
                <div class="side-row" id="player-wrap">
                  <span class="side-k">접속 중</span>
                  <p class="side-v" id="player-list" hidden></p>
                </div>
                <div class="side-row">
                  <span class="side-k">게임 버전</span>
                  <span class="side-v num" id="game-version">확인 중</span>
                  <span class="side-note">클라이언트도 같은 버전이어야 접속됩니다</span>
                </div>
                <div class="side-row">
                  <span class="side-k">월드</span>
                  <span class="side-v mono">gaybar</span>
                  <span class="side-note">설정은 월드 탭에 적어 두었습니다</span>
                </div>
              </div>

              <Callout title="상태 표시가 늦을 수 있습니다" tone="info">
                서버 PC 가 1분에 한 번 상태를 올립니다. 방금 켰다면 잠시 뒤
                다시 보세요.
              </Callout>
            </aside>
          </div>
        </div>

        <div slot="mods">
          <PageHead
            kicker="이 서버에 적용된 것"
            title="모드"
            icon="package-02"
            desc="위에서부터 반드시 해야 하는 것, 하고 싶으면 하는 것, 신경 쓰지 않아도 되는 것 순서입니다."
          >
            <div class="count-pills" slot="aside">
              <span class="pill">
                <Icon name="package-02" size={14} />
                전체 {modsData.mods.length}개
              </span>
              <span class={`pill ${needsAnyInstall ? "pill-hot" : "pill-ok"}`}>
                <Icon name={needsAnyInstall ? "download-04" : "checkmark-circle-02"} size={14} />
                전원 필수 {tier3.length}개
              </span>
              {tier2.length > 0 && (
                <span class="pill pill-pick">
                  <Icon name="puzzle" size={14} />
                  원하면 설치 {tier2.length}개
                </span>
              )}
            </div>
          </PageHead>

          {needsAnyInstall ? (
            <section class="group">
              <div class="group-h">
                <h2>
                  <Icon name="download-04" size={19} />
                  전원이 설치해야 하는 모드
                </h2>
                <p class="lead">
                  {tier3.length}개입니다. 하나라도 빠지면 접속할 수 없습니다.
                  설치 가이드 탭의 순서대로 하면 한 번에 끝납니다.
                </p>
              </div>

              {/*
                버전 경고와 인벤토리 충돌 경고를 여기 두지 않는다.
                버전은 이제 프로필 파일이 맞춰 주므로 친구가 고를 일이 없고,
                인벤토리 충돌은 data/mods.json 의 warnings 를 통해 해당 카드
                안에 그대로 나온다. 같은 말을 두 번 하면 둘 다 안 읽힌다.
              */}
              <div class="grid">
                {tier3.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          ) : (
            <section class="group">
              <div class="group-h group-h-ok">
                <h2>
                  <Icon name="checkmark-circle-02" size={19} />
                  직접 설치할 것은 없습니다
                </h2>
              </div>
              <Callout title="지금은 아무것도 설치하지 않아도 됩니다" tone="success">
                아래 모드는 전부 서버에만 깔려 있습니다. 그냥 발헤임을 켜고
                접속하시면 됩니다. 설치가 필요한 모드가 생기면 이 자리에
                카드로 올라옵니다.
              </Callout>
            </section>
          )}

          {tier2.length > 0 && (
            <section class="group">
              <div class="group-h group-h-pick">
                <h2>
                  <Icon name="puzzle" size={19} />
                  원하는 사람만 설치하는 모드
                </h2>
                <p class="lead">
                  {tier2.length}개입니다. <strong>안 깔아도 접속에는 지장이 없습니다.</strong>{" "}
                  쓰고 싶은 것만 각자 골라 받으시면 됩니다. 사람마다 달라도 되고
                  버전도 맞출 필요가 없습니다.
                </p>
              </div>
              <div class="grid">
                {tier2.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          )}

          {tier1.length > 0 && (
            <section class="group">
              <div class="group-h group-h-ok">
                <h2>
                  <Icon name="server-stack-01" size={19} />
                  서버에만 깔린 모드
                </h2>
                <p class="lead">
                  {tier1.length}개입니다. 접속하면 저절로 적용되니 읽고 넘기셔도 됩니다.
                </p>
              </div>
              <div class="grid">
                {tier1.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          )}
        </div>

        <div slot="install">
          <PageHead
            kicker="한 화면에 한 단계씩"
            title="설치 가이드"
            icon="download-04"
            tone={needsAnyInstall ? "accent" : "success"}
            desc={needsAnyInstall
              ? "이미 설치하셨다면 맨 위 안내만 보시면 됩니다. 처음이라면 그 아래 단계를 순서대로 넘기며 따라 하세요. 10분 정도 걸립니다."
              : "지금은 따라 할 필요가 없습니다. 앞으로 설치가 필요한 모드가 생겼을 때를 위해 적어 둡니다."}
          />

          {/*
            설치할 것이 있다는 안내는 여기 두지 않는다. 이 탭을 연 사람은
            이미 설치하러 온 사람이고, 개수와 목록은 모드 탭에, 파일 하나로
            끝난다는 사실은 3단계에 적혀 있다.

            반대로 설치할 것이 없을 때는 알려 줘야 한다. 그냥 켜고 들어오면
            된다는 사실을 모르면 이 절차를 처음부터 따라 하게 된다.
          */}
          {!needsAnyInstall && (
            <Callout title="지금 친구들은 아무것도 설치하지 않아도 접속됩니다" tone="success">
              현재 서버에는 서버에만 깔리는 모드만 있습니다. 발헤임을 그냥 켜고
              서버 탭의 주소로 들어오시면 됩니다. 아래 절차는 앞으로 직접 설치할
              모드가 추가될 때를 위한 안내입니다.
            </Callout>
          )}

          {/*
            이미 설치한 사람을 위한 자리다.

            지금 친구들은 전원이 한 번씩 설치를 마친 상태라, 이 탭을 다시
            여는 이유는 대부분 "모드가 바뀌었다니 다시 받아야 한다" 이다.
            그런 사람에게 8단계를 처음부터 보여주면 이미 아는 것을 다시
            읽게 되고, 정작 다른 한 곳(Update existing profile)을 놓친다.

            그래서 위저드보다 앞에 두고, 처음 설치와 다른 곳만 적는다.
            처음인 사람은 제목을 보고 건너뛴다.
          */}
          <section class="upg" id="update">
            <div class="upg-h">
              <h2>
                <Icon name="system-update-01" size={19} />
                이미 설치하셨다면
              </h2>
              <p class="lead">
                r2modman 에 <Hi text="gaybar" ui />{" "}프로필이 이미 있다면 처음부터
                다시 할 필요가 없습니다. 파일만 새로 받아 덮어쓰면 끝납니다.
                1분이면 됩니다.
              </p>
            </div>

            <Callout title="이럴 때 다시 받으시면 됩니다" tone="info">
              서버 탭의 모드팩 갱신 날짜가 마지막으로 받은 날보다 뒤일 때, 또는
