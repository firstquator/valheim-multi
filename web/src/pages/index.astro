---
// base 경로 뒤에 파일 이름을 안전하게 잇는다. BASE_URL 끝의 슬래시 유무에
// 관계없이 정확히 하나만 남긴다.
const base = (file) => `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/${file}`;

import "../styles/tokens.css";
import Sidebar from "../components/Sidebar.astro";
import Tabs from "../components/Tabs.astro";
import CopyField from "../components/CopyField.astro";
import Icon from "../components/Icon.astro";
import ModCard from "../components/ModCard.astro";
import Callout from "../components/Callout.astro";
import PageHead from "../components/PageHead.astro";
import Hi from "../components/Hi.astro";
import Shot from "../components/Shot.astro";

// r2modman 창을 그대로 보여주는 자리는 실제 화면 사진(Shot)을 쓴다. 손으로
// 그린 도식은 사진으로 대신할 수 없는 것만 남겼다. 전체 흐름, 어디서 켜느냐에
// 따른 결과 차이, 버전이 어긋났을 때 벌어지는 일이 그것이다.
import DiagramFlow from "../components/diagrams/DiagramFlow.astro";
import DiagramLaunch from "../components/diagrams/DiagramLaunch.astro";
import DiagramVersion from "../components/diagrams/DiagramVersion.astro";
import { SERVER } from "../config.mjs";
import modsData from "../../../data/mods.json";

const TABS = [
  { id: "server", label: "서버", icon: "home-01" },
  { id: "mods", label: "모드", icon: "package-02" },
  { id: "install", label: "설치 가이드", icon: "download-04" },
  { id: "world", label: "월드", icon: "globe-02" },
];

// 계층은 친구가 할 일로 나뉜다.
//   3층 전원 필수 / 2층 원하면 설치 / 1층 서버 전용
// 개수는 전부 data/mods.json 에서 세어 쓴다. 숫자를 손으로 적지 않는다.
const tier1 = modsData.mods.filter((m) => m.tier === 1);
const tier2 = modsData.mods.filter((m) => m.tier === 2);
const tier3 = modsData.mods.filter((m) => m.tier === 3);
const modpackCode = modsData.modpack.r2modmanCode;

// r2modman 이 그대로 읽는 프로필 파일이다. scripts/build-modpack.mjs 가
// data/mods.json 에서 만들어 web/public/ 에 놓는다. 여기 적는 이름은 그
// 스크립트의 출력 파일 이름과 같아야 한다.
//
// base() 를 거치지 않고 "/gaybar-modpack.r2z" 로 쓰면 배포본에서 404 가 난다.
// 사이트가 /valheim-multi/ 아래에 놓이기 때문이다.
const MODPACK_FILE = "gaybar-modpack.r2z";
const modpackDepCount = modsData.modpack.dependencies.length;

// 화면 문구는 data/mods.json 의 내용에 따라 저절로 달라진다.
// 3층(직접 설치) 모드가 하나라도 있으면 "설치할 것이 있다" 로,
// 없으면 "지금은 없다" 로 읽힌다. 모드가 추가될 때 이 파일을 다시
// 고칠 필요가 없어야 한다.
const needsAnyInstall = tier3.length > 0;

// 설치 가이드는 한 화면에 한 단계씩 보여준다.
// 여기 순서가 진행 표시와 화면 순서를 함께 정한다.
// 마지막 칸은 단계가 아니라 끝났다는 것을 알리는 화면이다.
const STEPS = [
  { n: 1, label: "r2modman 설치" },
  { n: 2, label: "발헤임 고르기" },
  { n: 3, label: "프로필 파일 가져오기" },
  { n: 4, label: "Start modded" },
  { n: 5, label: "서버 접속" },
  { n: 6, label: "완료" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      검색엔진 색인을 막는다. 저장소는 비공개지만 GitHub Pages 로 배포되면
      사이트 자체는 공개적으로 접근 가능해지고, 이 페이지에는 서버 접속
      주소와 비밀번호가 그대로 담겨 있다. 이 태그는 검색엔진 수집만
      막을 뿐, 주소를 이미 아는 사람의 접근을 막지는 못한다. 자세한 내용은
      docs/guides/github-pages-deploy.md 를 본다.
    -->
    <meta name="robots" content="noindex, nofollow" />

    {/* 파비콘은 base 경로를 붙여서 가리킨다. 프로젝트 Pages 라 사이트가
        /valheim-multi/ 아래에 놓이는데, 링크가 없으면 브라우저가 오리진
        루트의 /favicon.ico 를 찾다가 404 를 낸다.

        BASE_URL 은 설정에 따라 끝에 슬래시가 있을 수도 없을 수도 있다.
        그냥 이어 붙이면 /valheim-multifavicon.svg 가 된다. 실제로 겪었다. */}
    <link rel="icon" href={base("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={base("favicon.ico")} sizes="any" />

    <title>gaybar 서버</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.20/index.min.css"
    />
  </head>
  <body>
    <div class="shell">
      {TABS.map((t, i) => (
        <input
          type="radio"
          name="tab"
          id={`tab-${t.id}`}
          class="tab-radio sr-only"
          checked={i === 0}
        />
      ))}

      <Tabs tabs={TABS}>
        <div slot="server">
          <PageHead
            kicker="발헤임 전용 서버"
            title="gaybar"
            icon="home-01"
            desc="주소와 비밀번호만 있으면 들어올 수 있습니다. 설치할 모드가 있는지는 모드 탭에서 확인하세요."
          >
            <div class="status-pill" slot="aside">
              <p class="badge" id="status-badge" data-state="unknown" aria-live="polite" aria-atomic="true">상태 확인 중</p>
              <p class="age" id="status-age"></p>
            </div>
          </PageHead>

          <div class="cols cols-wide">
            <section class="block">
              <h2 class="block-h">
                <Icon name="key-01" size={17} />
                접속 정보
              </h2>
              <div class="card card-lead">
                <CopyField label="주소" value={SERVER.address} mono id="server-address" />
                <CopyField label="비밀번호" value={SERVER.password} masked />
              </div>
            </section>

            <aside class="block">
              <h2 class="block-h">
                <Icon name="user-group" size={17} />
                지금 서버
              </h2>

              <div class="card side-card">
                <div class="side-row" id="player-wrap">
                  <span class="side-k">접속 중</span>
                  <p class="side-v" id="player-list" hidden></p>
                </div>
                <div class="side-row">
                  <span class="side-k">게임 버전</span>
                  <span class="side-v num" id="game-version">확인 중</span>
                  <span class="side-note">클라이언트도 같은 버전이어야 접속됩니다</span>
                </div>
                <div class="side-row">
                  <span class="side-k">월드</span>
                  <span class="side-v mono">gaybar</span>
                  <span class="side-note">설정은 월드 탭에 적어 두었습니다</span>
                </div>
              </div>

              <Callout title="상태 표시가 늦을 수 있습니다" tone="info">
                서버 PC 가 1분에 한 번 상태를 올립니다. 방금 켰다면 잠시 뒤
                다시 보세요.
              </Callout>
            </aside>
          </div>
        </div>

        <div slot="mods">
          <PageHead
            kicker="이 서버에 적용된 것"
            title="모드"
            icon="package-02"
            desc="위에서부터 반드시 해야 하는 것, 하고 싶으면 하는 것, 신경 쓰지 않아도 되는 것 순서입니다."
          >
            <div class="count-pills" slot="aside">
              <span class="pill">
                <Icon name="package-02" size={14} />
                전체 {modsData.mods.length}개
              </span>
              <span class={`pill ${needsAnyInstall ? "pill-hot" : "pill-ok"}`}>
                <Icon name={needsAnyInstall ? "download-04" : "checkmark-circle-02"} size={14} />
                전원 필수 {tier3.length}개
              </span>
              {tier2.length > 0 && (
                <span class="pill pill-pick">
                  <Icon name="puzzle" size={14} />
                  원하면 설치 {tier2.length}개
                </span>
              )}
            </div>
          </PageHead>

          {needsAnyInstall ? (
            <section class="group">
              <div class="group-h">
                <h2>
                  <Icon name="download-04" size={19} />
                  전원이 설치해야 하는 모드
                </h2>
                <p class="lead">
                  {tier3.length}개입니다. 하나라도 빠지면 접속할 수 없습니다.
                  설치 가이드 탭의 순서대로 하면 한 번에 끝납니다.
                </p>
              </div>

              <div class="callouts">
                <Callout title="전원이 정확히 같은 버전을 설치해야 합니다">
                  Thunderstore 에서 최신 버전을 임의로 받지 마세요. 아래 카드에 적힌
                  버전 번호를 그대로 설치해야 합니다. 한 명이라도 버전이 다르면 그
                  사람은 서버에 접속할 수 없습니다.
                </Callout>
                <Callout title="인벤토리 모드는 하나만 설치하세요">
                  ExtraSlots, EquipmentAndQuickSlots, AzuExtendedPlayerInventory 는
                  같은 코드를 건드립니다. 둘 이상 설치하면 슬롯이 늘어나는 것이 아니라
                  재접속할 때 아이템이 사라집니다.
                </Callout>
              </div>

              <div class="grid">
                {tier3.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          ) : (
            <section class="group">
              <div class="group-h group-h-ok">
                <h2>
                  <Icon name="checkmark-circle-02" size={19} />
                  직접 설치할 것은 없습니다
                </h2>
              </div>
              <Callout title="지금은 아무것도 설치하지 않아도 됩니다" tone="success">
                아래 모드는 전부 서버에만 깔려 있습니다. 그냥 발헤임을 켜고
                접속하시면 됩니다. 설치가 필요한 모드가 생기면 이 자리에
                카드로 올라옵니다.
              </Callout>
            </section>
          )}

          {tier2.length > 0 && (
            <section class="group">
              <div class="group-h group-h-pick">
                <h2>
                  <Icon name="puzzle" size={19} />
                  원하는 사람만 설치하는 모드
                </h2>
                <p class="lead">
                  {tier2.length}개입니다. <strong>안 깔아도 접속에는 지장이 없습니다.</strong>{" "}
                  쓰고 싶은 것만 각자 골라 받으시면 됩니다. 사람마다 달라도 되고
                  버전도 맞출 필요가 없습니다.
                </p>
              </div>
              <div class="grid">
                {tier2.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          )}

          {tier1.length > 0 && (
            <section class="group">
              <div class="group-h group-h-ok">
                <h2>
                  <Icon name="server-stack-01" size={19} />
                  서버에만 깔린 모드
                </h2>
                <p class="lead">
                  {tier1.length}개입니다. 접속하면 저절로 적용되니 읽고 넘기셔도 됩니다.
                </p>
              </div>
              <div class="grid">
                {tier1.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          )}
        </div>

        <div slot="install">
          <PageHead
            kicker="한 화면에 한 단계씩"
            title="설치 가이드"
            icon="download-04"
            tone={needsAnyInstall ? "accent" : "success"}
            desc={needsAnyInstall
              ? "아래 순서대로 한 단계씩 넘기며 따라 하시면 됩니다. 처음이라면 10분 정도 걸립니다."
              : "지금은 따라 할 필요가 없습니다. 앞으로 설치가 필요한 모드가 생겼을 때를 위해 적어 둡니다."}
          />

          {needsAnyInstall ? (
            <Callout title={`전원이 설치해야 하는 모드가 ${tier3.length}개 있습니다`}>
              설치하지 않으면 서버에 접속할 수 없습니다. 어떤 모드인지는 모드 탭에
              적혀 있고, 3단계의 프로필 파일 하나로 한꺼번에 설치됩니다.
            </Callout>
          ) : (
            <Callout title="지금 친구들은 아무것도 설치하지 않아도 접속됩니다" tone="success">
              현재 서버에는 서버에만 깔리는 모드만 있습니다. 발헤임을 그냥 켜고
              서버 탭의 주소로 들어오시면 됩니다. 아래 절차는 앞으로 직접 설치할
              모드가 추가될 때를 위한 안내입니다.
            </Callout>
          )}

          {/*
            단계 전환용 라디오다. 탭 전환과 같은 방식으로 CSS 형제 선택자만
            쓴다. JavaScript 를 쓰지 않는다.

            name 은 탭 라디오의 "tab" 과 반드시 달라야 한다. 겹치면 단계를
            고를 때 탭 라디오가 풀려 화면이 통째로 사라진다.

            화면에서만 가리고 키보드 포커스는 남긴다. display:none 을 쓰면
            Tab 으로 도달할 수 없고 화살표로 단계를 넘길 수도 없어진다.
          */}
          {STEPS.map((s, i) => (
            <input
              type="radio"
              name="step"
              id={`step-${s.n}`}
              class="step-radio sr-only"
              checked={i === 0}
            />
          ))}

          <div class="wizard">
            <nav class="wiz-nav" aria-label="설치 단계">
              <ol>
                {STEPS.map((s) => (
                  <li>
                    <label for={`step-${s.n}`}>
                      <span class="wiz-dot">{s.n}</span>
                      <span class="wiz-dot-label">{s.label}</span>
                    </label>
                  </li>
                ))}
              </ol>
              <div class="wiz-bar"><span class="wiz-bar-fill"></span></div>
            </nav>

            <div class="wiz-screens">
              <section class="wiz-screen" data-step="1">
                <div class="wiz-body">
                  <p class="wiz-kicker">1 / {STEPS.length} 단계</p>
                  <h3 class="wiz-title">r2modman 을 내려받습니다</h3>
                  <p class="wiz-lead">
                    모드를 프로필 단위로 관리해 주는 프로그램입니다. 게임 폴더를
                    직접 건드리지 않으므로 바닐라로 되돌리기도 쉽습니다.
                  </p>

                  <figure class="wiz-fig">
                    <DiagramFlow />
                    <figcaption>앞으로 이런 순서로 갑니다. 4단계만 틀리지 않으면 나머지는 쉽습니다.</figcaption>
                  </figure>

                  <ul class="ticks">
                    <li>
                      <Icon name="arrow-right-02" size={16} />
                      <span>
                        <a href="https://thunderstore.io/package/ebkr/r2modman/" target="_blank" rel="noopener noreferrer">
                          Thunderstore 의 r2modman 페이지
                          <Icon name="arrow-up-right-01" size={14} />
                          <span class="sr-only">새 탭에서 열림</span>
                        </a>
                        를 열고 오른쪽의 보라색 <Hi text="Download" ui /> 를 누릅니다
                      </span>
                    </li>
                    <li>
                      <Icon name="arrow-right-02" size={16} />
                      <span>
                        바로 위의 초록색 <Hi text="Install with App" tone="caution" ui /> 은
                        Thunderstore 앱이 따로 있어야 동작합니다. 누르지 마세요
                      </span>
                    </li>
                  </ul>

                  <figure class="wiz-fig">
                    <Shot
                      src={base("guide/01-thunderstore.png")}
                      alt="Thunderstore 의 r2modman 페이지. 오른쪽 위에 초록색 Install with App 버튼이, 그 아래에 보라색 Download 버튼이 있습니다."
                      width={2105}
                      height={1174}
                      marks={[
                        { x: 75.0, y: 19.8, w: 22.5, h: 7.4, tone: "caution" },
                        { x: 75.0, y: 27.4, w: 14.2, h: 5.6, n: 1 },
                      ]}
                    />
                    <figcaption>
                      1번이 눌러야 하는 버튼입니다. 그 위의 초록색 버튼은 다른
                      프로그램을 요구하니 지나칩니다.
                    </figcaption>
                  </figure>

                  <ul class="ticks">
                    <li>
                      <Icon name="arrow-right-02" size={16} />
                      <span>받은 압축 파일을 풀고 안에 있는 Setup 파일을 실행합니다</span>
                    </li>
                    <li>
                      <Icon name="arrow-right-02" size={16} />
                      <span>
                        윈도우가 알 수 없는 앱이라고 막으면 추가 정보를 누르고
                        실행을 고릅니다
                      </span>
                    </li>
                  </ul>

                  <figure class="wiz-fig">
                    <Shot
                      src={base("guide/02-download-folder.png")}
                      alt="압축을 푼 폴더. 여러 파일 가운데 r2modman-Setup 으로 시작하는 응용 프로그램 파일이 골라져 있습니다."
                      width={1051}
                      height={592}
                      marks={[{ x: 16.5, y: 54.5, w: 21.5, h: 5.6 }]}
                    />
                    <figcaption>
                      폴더 안에 파일이 여러 개지만 실행할 것은 Setup 하나입니다.
                      버전 번호는 받은 시점에 따라 다를 수 있습니다.
                    </figcaption>
                  </figure>
                </div>
                <footer class="wiz-foot">
                  <span class="wiz-hint">화살표 키로도 단계를 넘길 수 있습니다</span>
                  <label class="wbtn wbtn-go" for="step-2">
                    다음
                    <Icon name="arrow-right-02" size={17} />
                  </label>
                </footer>
              </section>

              <section class="wiz-screen" data-step="2">
                <div class="wiz-body">
                  <p class="wiz-kicker">2 / {STEPS.length} 단계</p>
                  <h3 class="wiz-title">발헤임과 Steam 을 고릅니다</h3>
                  <p class="wiz-lead">
                    r2modman 을 처음 켜면 게임 목록이 나옵니다. 게임을 고르고
                    이어서 플랫폼까지 고르면 다음부터는 묻지 않습니다.
                  </p>

                  <ul class="ticks ticks-big">
                    <li>
                      <Icon name="arrow-right-02" size={16} />
                      <span>
