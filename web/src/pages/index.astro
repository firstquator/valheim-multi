<style is:global>
  /* 화면에서만 가리고 키보드 포커스와 스크린리더 접근은 유지한다.
     display:none 이나 hidden 속성을 쓰면 Tab 키로 도달할 수 없어진다. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 사이드바는 64px 을 덮고 콘텐츠를 밀지 않는다.
     그만큼만 비워 두고 나머지 폭은 전부 콘텐츠가 쓴다. */
  .shell { padding-left: var(--sidebar-w-collapsed); }

  .panels {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 44px var(--pad-x) 110px;
  }

  /* 넓은 화면에서는 두 단으로 나눠 오른쪽이 비지 않게 한다.
     좁아지면 한 단으로 떨어진다. */
  .cols {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  .cols-wide { grid-template-columns: minmax(0, 1.55fr) minmax(320px, 1fr); }
  @media (max-width: 1024px) {
    .cols-wide { grid-template-columns: minmax(0, 1fr); }
  }

  /* 서버 탭 제목 옆의 상태 표시. */
  .status-pill {
    padding: 10px 16px;
    text-align: right;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-dim);
  }
  .badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-faint);
  }
  .badge[data-state="running"] { color: var(--success-bright); }
  .badge[data-state="running"]::before {
    background: var(--success);
    box-shadow: var(--shadow-pulse-start);
    animation: pulse 2.4s ease-out infinite;
  }
  .badge[data-state="offline"] { color: var(--text-faint); }
  @keyframes pulse {
    to { box-shadow: var(--shadow-pulse-end); }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge[data-state="running"]::before { animation: none; }
  }
  .age { margin: 2px 0 0; font-size: 12px; color: var(--text-faint); }

  /* 구역 제목. 탭 제목보다 한 단계 작고 아이콘을 앞에 둔다. */
  .block-h {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text-dim);
  }
  .block-h .icon { color: var(--accent); }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  /* 서버 탭의 주소와 비밀번호는 이 페이지에서 가장 자주 쓰는 값이다.
     다른 카드보다 크게 보이도록 값 글자를 키운다. */
  .card-lead .v { font-size: 17px; }
  .card-lead .field { padding: 16px 20px; }

  /* 모드팩 갱신 알림.

     접속 정보 위에 놓이므로 무게가 그보다 가벼우면 안 되고, 그렇다고
     화면을 혼자 차지해서도 안 된다. 그래서 카드 자체는 접속 정보와 같은
     모양을 쓰고, 다시 받아야 할 때만 테두리와 배경으로 색을 올린다.

     왼쪽에 띠를 긋지 않는다. 이 프로젝트에서 쓰지 않기로 한 장식이다. */
  .upd { margin-bottom: 24px; }
  .upd-card { padding: 18px 20px; }
  .upd[data-hot="true"] .upd-card {
    border-color: var(--warning);
    background:
      linear-gradient(rgb(196 99 74 / 0.07), rgb(196 99 74 / 0.07)),
      var(--surface);
    box-shadow: var(--shadow-card), var(--ring-warning);
  }
  .upd[data-hot="true"] .block-h .icon { color: var(--warning-bright); }

  /* 판정 한 줄. 이것만 읽어도 무엇을 해야 하는지 알 수 있어야 한다. */
  .upd-verdict {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--success-bright);
  }
  .upd[data-hot="true"] .upd-verdict { color: var(--warning-bright); }

  .upd-sum {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text);
    max-width: var(--measure);
  }
  .upd-when {
    display: flex;
    gap: 7px;
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: var(--measure);
  }
  .upd-when .icon { flex: none; margin-top: 3px; color: var(--text-faint); }
  .upd-when time { color: var(--text); font-weight: 600; }

  /* 설치 가이드 탭으로 보내는 버튼. label 이라 JavaScript 없이 탭이
     바뀐다. 누르는 것이므로 커서와 눌림 반응을 버튼처럼 준다. */
  .upd-go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 11px 18px;
    border: 1px solid var(--warning);
    border-radius: var(--radius-sm);
    background: var(--warning);
    color: var(--bg-deep);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms var(--ease-out);
  }
  .upd-go:hover {
    background: var(--warning-bright);
    border-color: var(--warning-bright);
  }
  .upd-go:active { transform: translateY(1px); }
  .upd-go .icon { transition: transform 180ms var(--ease-out); }
  .upd-go:hover .icon { transform: translateX(3px); }

  .upd-log { margin-top: 16px; }
  .upd-log summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--text-dim);
  }
  .upd-log summary:hover { color: var(--text); }
  .upd-log ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .upd-log li {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: var(--measure);
  }
  .upd-log time {
    display: block;
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .upd-go,
    .upd-go .icon { transition: none; }
    .upd-go:active { transform: none; }
    .upd-go:hover .icon { transform: none; }
  }

  /* 설치 가이드 탭의 "이미 설치하셨다면" 구역.

     위저드보다 앞에 오지만 위저드처럼 화면을 차지하면 안 된다. 읽을 것이
     네 줄뿐이라 카드 하나로 묶고, 아래 위저드와는 구분선으로 떼어 놓는다. */
  /* 아래 위저드와 같은 패널로 만든다.

     처음에는 패널 없이 요소만 늘어놓았는데, Callout 은 화면 끝까지 가고
     글줄은 --measure 에서 끊겨 폭이 층층이 달라 보였다. 위저드와 같은
     상자에 담으면 폭이 저절로 맞고 하나의 덩어리로 읽힌다. */
  .upg {
    margin: 0 0 8px;
    padding: 36px 44px 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
  }
  .upg-h { margin-bottom: 14px; }
  .upg-h h2 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .upg-h h2 .icon { color: var(--accent); }
  .upg-h .lead {
    max-width: var(--measure);
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-dim);
  }
  .upg .callout { margin-top: 14px; }
  .upg .dl { margin-top: 16px; }
  .upg .wiz-fig { margin-top: 18px; }

  /* 번호를 원문자로 쓰지 않고 칩으로 그린다. 네 단계뿐이라 진행 표시는
     필요 없지만 순서는 분명해야 한다. */
  .upg-steps {
    max-width: var(--measure);
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .upg-steps li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .upg-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent-deep);
    color: var(--text);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .upg-t {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text);
  }

  /* 업데이트 안내와 처음 설치 위저드 사이의 구분선.
     여기서부터 읽을 사람이 달라진다는 것을 보여 준다. */
  .upg-split {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 32px 0 24px;
    color: var(--text-faint);
    font-size: 13px;
  }
  .upg-split::before,
  .upg-split::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }


  /* ===== 도감 =====
     아이템이 1000 개가 넘는다. 화면을 꽉 채우는 격자로 훑게 하고,
     자세한 것은 눌렀을 때만 보여 준다.

     상세는 숫자만 놓지 않는다. "방어력 14" 는 처음 보는 사람에게 뜻이
     없으므로 그것이 무엇인지 한 줄과, 게임 전체에서 어디쯤인지 보여
     주는 막대를 함께 둔다. */

  .dex-tools {
    display: grid;
    gap: 14px;
    margin-bottom: 22px;
  }
  .dex-search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .dex-search:focus-within {
    border-color: var(--accent);
    box-shadow: var(--ring-accent);
  }
  .dex-search .icon { color: var(--text-faint); flex: none; }
  .dex-search input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 15px;
  }
  .dex-search input::placeholder { color: var(--text-faint); }
  /* 검색창의 기본 지우기 단추는 다크 테마에서 검게 나와 안 보인다. */
  .dex-search input::-webkit-search-cancel-button { filter: invert(0.7); }

  .dex-filter { display: flex; align-items: baseline; gap: 12px; }
  .dex-f-label {
    flex: none;
    width: 62px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .dex-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .dex-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-dim);
    font-family: var(--font-sans);
    font-size: 13px;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .dex-chip:hover { color: var(--text); border-color: var(--border-strong); }
  .dex-chip.on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-deep);
    font-weight: 700;
  }

  /* 바이옴 점. 글자를 읽기 전에 어느 단계인지 알아보게 한다. */
  .dex-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-faint);
  }
  [data-stage="0"] .dex-dot { background: var(--biome-0); }
  [data-stage="1"] .dex-dot { background: var(--biome-1); }
  [data-stage="2"] .dex-dot { background: var(--biome-2); }
  [data-stage="3"] .dex-dot { background: var(--biome-3); }
  [data-stage="4"] .dex-dot { background: var(--biome-4); }
  [data-stage="5"] .dex-dot { background: var(--biome-5); }
  [data-stage="6"] .dex-dot { background: var(--biome-6); }
  [data-stage="7"] .dex-dot { background: var(--biome-7); }
  .dex-chip.on .dex-dot { background: var(--bg-deep); }

  .dex-note {
    margin: 0;
    padding-left: 74px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .dex-note[hidden] { display: none; }

  .dex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
    gap: 10px;
  }
  .dex-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 13px;
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: border-color 160ms ease, transform 160ms var(--ease-out), background 160ms ease;
  }
  .dex-card:hover {
    border-color: var(--accent);
    background: var(--surface-raised);
    transform: translateY(-2px);
  }
  .dex-ico {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--surface-sunken);
    border-radius: var(--radius-sm);
  }
  .dex-ico img { width: 38px; height: 38px; object-fit: contain; }
  .dex-noicon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 1px dashed var(--border-strong);
  }
  .dex-txt { min-width: 0; display: grid; gap: 4px; }
  .dex-name {
    font-size: 14px;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* 한 줄에 단계와 대표 수치를 함께 둔다. 카드를 열지 않고도
     "늪 것이고 공격력 55" 까지 읽히게 하는 것이 목적이다. */
  .dex-sub {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 11.5px;
    color: var(--text-faint);
  }
  .dex-biome {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
  }
  .dex-stat {
    padding-left: 8px;
    border-left: 1px solid var(--border-strong);
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dex-more {
    grid-column: 1 / -1;
    padding: 14px;
    margin-top: 6px;
    border-radius: var(--radius-sm);
    border: 1px dashed var(--border-strong);
    background: none;
    color: var(--text-dim);
    font-family: var(--font-sans);
    font-size: 14px;
    cursor: pointer;
  }
  .dex-more .num { color: var(--text-faint); }
  .dex-more:hover { color: var(--text); border-color: var(--accent); }
  .dex-empty {
    grid-column: 1 / -1;
    padding: 40px 0;
    text-align: center;
    color: var(--text-faint);
  }

  /* ----- 상세 ----- */

  .dex-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgb(0 0 0 / 0.62);
  }
  .dex-modal[hidden] { display: none; }
  .dex-panel {
    position: relative;
    width: min(680px, 100%);
    max-height: min(86vh, 860px);
    overflow-y: auto;
    padding: 0 30px 26px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
  }
  /* 스크롤해도 닫기와 뒤로는 늘 손에 닿아야 한다. */
  .dex-panel-top {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 -30px;
    padding: 14px 30px 10px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .dex-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px 6px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-sunken);
    color: var(--text-dim);
    font-family: var(--font-sans);
    font-size: 13px;
    cursor: pointer;
  }
  .dex-back:hover { color: var(--text); border-color: var(--border-strong); }
  .dex-back[hidden] { display: none; }
  .dex-close {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface-sunken);
    color: var(--text-dim);
    cursor: pointer;
  }
  .dex-close:hover { color: var(--text); border-color: var(--border-strong); }

  .dex-d-head { display: flex; align-items: center; gap: 18px; margin-top: 20px; }
  .dex-d-ico {
    flex: none;
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .dex-d-ico img { width: 66px; height: 66px; object-fit: contain; }
  .dex-d-title { min-width: 0; }
  .dex-d-head h3 { margin: 0; font-size: 23px; font-weight: 800; color: var(--text); }
  .dex-d-en { margin: 2px 0 0; font-size: 13px; color: var(--text-faint); }

  .dex-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }
  .dex-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-dim);
  }
  .dex-tag-stage { color: var(--text); }

  .dex-d-desc {
    margin: 18px 0 0;
    padding-left: 13px;
    border-left: 2px solid var(--accent-deep);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .dex-warn {
    margin: 16px 0 0;
    padding: 12px 15px;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
    background: color-mix(in srgb, var(--warning) 12%, transparent);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .dex-warn b { color: var(--warning-bright); }

  /* 가장 먼저 봐야 할 숫자. 여기만 보고 덮어도 되게 한다. */
  .dex-keys {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 8px;
    margin-top: 18px;
  }
  .dex-key {
    display: grid;
    gap: 2px;
    padding: 13px 14px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .dex-key-v { font-size: 22px; font-weight: 800; color: var(--accent-bright); line-height: 1.2; }
  .dex-key-v em { font-style: normal; font-size: 13px; font-weight: 600; margin-left: 2px; }
  .dex-key-l { font-size: 12px; color: var(--text-faint); }

  .dex-sec { margin-top: 26px; }
  .dex-sec h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 11px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }
  .dex-cnt {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--surface-raised);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-dim);
  }
  .dex-foot {
    margin: 10px 0 0;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--text-faint);
  }
  .dex-foot b { color: var(--text-dim); font-weight: 600; }

  /* 막대. 숫자 하나로는 55 가 센지 약한지 알 수 없다. */
  .dex-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .dex-bar-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .dex-bar-k { font-size: 14px; font-weight: 700; color: var(--text); }
  .dex-bar-v { font-size: 15px; font-weight: 800; color: var(--accent-bright); }
  .dex-bar {
    margin-top: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--surface-raised);
    overflow: hidden;
  }
  .dex-bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent-deep), var(--accent));
  }
  .dex-bar-n {
    margin: 6px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  /* 수치. 값 옆에 그것이 무엇인지 함께 둔다. */
  .dex-dl { display: grid; gap: 8px; margin: 0; }
  .dex-dl > div {
    display: grid;
    grid-template-columns: 78px 1fr;
    column-gap: 14px;
    padding: 12px 15px;
    background: var(--surface-raised);
    border-radius: var(--radius-sm);
  }
  .dex-dl dt { font-size: 12.5px; color: var(--text-faint); padding-top: 2px; }
  .dex-dl dd { margin: 0; display: grid; gap: 3px; }
  .dex-dl dd b { font-size: 15px; font-weight: 700; color: var(--text); }
  .dex-dl dd span { font-size: 12.5px; line-height: 1.6; color: var(--text-dim); }

  /* 강화표. 끝까지 올리는 데 뭐가 얼마나 드는지 한 번에 보여 준다. */
  .dex-up-wrap { overflow-x: auto; }
  .dex-up {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .dex-up th, .dex-up td {
    padding: 9px 12px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  .dex-up thead th {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .dex-up tbody th {
    font-weight: 700;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .dex-up td { color: var(--text); }
  .dex-up-sum th, .dex-up-sum td {
    border-bottom: none;
    background: var(--surface-raised);
    color: var(--text);
  }
  .dex-up-sum th { color: var(--accent-bright); }
  .dex-up-m {
    display: inline-block;
    margin: 2px 10px 2px 0;
    white-space: nowrap;
  }
  .dex-up-m b { color: var(--accent-bright); font-weight: 700; }

  .dex-how { margin: 0; font-size: 14px; line-height: 1.7; color: var(--text); }
  .dex-how strong { color: var(--accent-bright); font-weight: 700; }

  /* 얻는 길이 둘 이상일 때. 청동은 만들 수도 있고 녹여서 얻을 수도 있다. */
  .dex-way { display: flex; gap: 12px; }
  .dex-way + .dex-way { margin-top: 18px; }
  .dex-way > div { flex: 1; min-width: 0; }
  .dex-way-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 21px;
    height: 21px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text-dim);
  }

  /* 재료와 쓰임새는 눌러서 그 아이템으로 건너뛴다. */
  .dex-mats { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }
  .dex-mat {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 13px;
    background: var(--surface-raised);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease;
  }
  .dex-mat:hover { border-color: var(--accent); background: var(--surface-sunken); }
  .dex-mat-ico { flex: none; width: 26px; height: 26px; display: grid; place-items: center; }
  .dex-mat-ico img { width: 26px; height: 26px; object-fit: contain; }
  .dex-mat-n { flex: 1; min-width: 0; font-size: 14px; color: var(--text); }
  .dex-mat-a { flex: none; font-size: 14px; font-weight: 700; color: var(--accent-bright); }
  .dex-mat-a em { color: var(--text-faint); font-style: normal; font-weight: 400; font-size: 12px; }

  .dex-uses { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .dex-use {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-raised);
    color: var(--text-dim);
    font-family: var(--font-sans);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .dex-use:hover { border-color: var(--accent); color: var(--text); }
  .dex-use img { width: 22px; height: 22px; object-fit: contain; flex: none; }

  .dex-d-id { margin: 26px 0 0; font-size: 11.5px; color: var(--text-faint); }
  .dex-d-id code { font-family: var(--font-mono); }

  @media (prefers-reduced-motion: reduce) {
    .dex-card, .dex-chip, .dex-search, .dex-mat, .dex-use { transition: none; }
    .dex-card:hover { transform: none; }
  }

  /* 서버 탭 오른쪽 요약 카드. */
  .side-card .side-row {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
  }
  .side-card .side-row:last-child { border-bottom: none; }
  .side-k {
    display: block;
    font-size: 12px;
    color: var(--text-faint);
  }
  .side-v {
    display: block;
    margin: 2px 0 0;
    font-size: 15px;
    color: var(--text);
    word-break: break-all;
  }
  .side-note {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: var(--text-faint);
  }
  /* Callout 은 자기 여백을 갖지 않는다. 앞 카드와 붙지 않게 여기서 띄운다. */
  .side-card + .callout { margin-top: 14px; }

  /* 모드 탭 제목 옆 개수 요약. */
  .count-pills { display: flex; gap: 8px; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .pill-hot {
    color: var(--accent-bright);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
  }
  .pill-ok {
    color: var(--success-bright);
    border-color: color-mix(in srgb, var(--success) 45%, transparent);
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
  }
  .pill-pick {
    color: var(--info-bright);
    border-color: color-mix(in srgb, var(--info) 45%, transparent);
    background: color-mix(in srgb, var(--info) 10%, var(--surface));
  }

  .group { margin-bottom: 52px; }
  .group:last-child { margin-bottom: 0; }
  .group-h { margin-bottom: 16px; }
  .group-h h2 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .group-h h2 .icon { color: var(--accent); }
  .group-h-ok h2 .icon { color: var(--success); }
  .group-h-pick h2 .icon { color: var(--info-bright); }
  /* 안 해도 된다는 사실이 흘려 읽히면 친구가 전부 설치해야 하는 줄 안다. */
  .lead strong { color: var(--text); font-weight: 700; }
  .lead {
    max-width: var(--measure);
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--text-dim);
    text-wrap: balance;
  }


  /* 카드가 3개든 10개든 무너지지 않게 자동으로 칸 수를 정한다. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--gap);
  }

  /* ── 설치 가이드 단계 화면 ───────────────────────────────────────
     한 번에 한 단계만 보여준다. 전환은 탭과 같은 방식으로 라디오와
     CSS 형제 선택자만 쓴다. JavaScript 를 쓰지 않는다.

     라디오(#step-1 ~ #step-6)는 이 div 안, .wizard 앞자리에 있다.
     `~` 가 닿으려면 같은 부모의 앞 형제여야 한다. */
  .wizard {
    margin-top: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }

  /* 진행 표시. 몇 번째인지, 전체가 몇 단계인지 한눈에 보인다. */
  .wiz-nav {
    padding: 22px 32px 0;
    background: var(--surface-sunken);
  }
  .wiz-nav ol {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 8px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .wiz-nav label {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 4px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--text-faint);
    transition: color 180ms ease;
  }
  .wiz-nav label:hover { color: var(--text-dim); }

  .wiz-dot {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .wiz-dot-label {
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 여기까지 왔다는 표시. :nth-child(-n+N) 으로 N 번째까지를 한 번에 잡는다. */
  #step-2:checked ~ .wizard .wiz-nav li:nth-child(-n+2) .wiz-dot,
  #step-3:checked ~ .wizard .wiz-nav li:nth-child(-n+3) .wiz-dot,
  #step-4:checked ~ .wizard .wiz-nav li:nth-child(-n+4) .wiz-dot,
  #step-5:checked ~ .wizard .wiz-nav li:nth-child(-n+5) .wiz-dot,
  #step-6:checked ~ .wizard .wiz-nav li:nth-child(-n+6) .wiz-dot,
  #step-7:checked ~ .wizard .wiz-nav li:nth-child(-n+7) .wiz-dot,
  #step-8:checked ~ .wizard .wiz-nav li:nth-child(-n+8) .wiz-dot {
    background: color-mix(in srgb, var(--accent) 22%, var(--surface-raised));
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent-bright);
  }

  /* 지금 단계. 채워서 확실히 구분한다. */
  #step-1:checked ~ .wizard .wiz-nav li:nth-child(1) .wiz-dot,
  #step-2:checked ~ .wizard .wiz-nav li:nth-child(2) .wiz-dot,
  #step-3:checked ~ .wizard .wiz-nav li:nth-child(3) .wiz-dot,
  #step-4:checked ~ .wizard .wiz-nav li:nth-child(4) .wiz-dot,
  #step-5:checked ~ .wizard .wiz-nav li:nth-child(5) .wiz-dot,
  #step-6:checked ~ .wizard .wiz-nav li:nth-child(6) .wiz-dot,
  #step-7:checked ~ .wizard .wiz-nav li:nth-child(7) .wiz-dot,
  #step-8:checked ~ .wizard .wiz-nav li:nth-child(8) .wiz-dot {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  #step-1:checked ~ .wizard .wiz-nav li:nth-child(1) label,
  #step-2:checked ~ .wizard .wiz-nav li:nth-child(2) label,
  #step-3:checked ~ .wizard .wiz-nav li:nth-child(3) label,
  #step-4:checked ~ .wizard .wiz-nav li:nth-child(4) label,
  #step-5:checked ~ .wizard .wiz-nav li:nth-child(5) label,
  #step-6:checked ~ .wizard .wiz-nav li:nth-child(6) label,
  #step-7:checked ~ .wizard .wiz-nav li:nth-child(7) label,
  #step-8:checked ~ .wizard .wiz-nav li:nth-child(8) label {
    color: var(--text);
  }

  /* 마지막은 끝났다는 뜻이라 초록으로 맺는다. */
  #step-8:checked ~ .wizard .wiz-nav li:nth-child(8) .wiz-dot {
    background: var(--success);
    border-color: var(--success);
  }

  /* 라디오는 화면에서만 가려 두었으므로 포커스 링을 해당 진행 표시에 그린다. */
  #step-1:focus-visible ~ .wizard .wiz-nav li:nth-child(1) label,
  #step-2:focus-visible ~ .wizard .wiz-nav li:nth-child(2) label,
  #step-3:focus-visible ~ .wizard .wiz-nav li:nth-child(3) label,
  #step-4:focus-visible ~ .wizard .wiz-nav li:nth-child(4) label,
  #step-5:focus-visible ~ .wizard .wiz-nav li:nth-child(5) label,
  #step-6:focus-visible ~ .wizard .wiz-nav li:nth-child(6) label,
  #step-7:focus-visible ~ .wizard .wiz-nav li:nth-child(7) label,
  #step-8:focus-visible ~ .wizard .wiz-nav li:nth-child(8) label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .wiz-bar {
    height: 3px;
    background: var(--border);
  }
  .wiz-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--highlight));
    transition: width 320ms var(--ease-out);
  }
  #step-1:checked ~ .wizard .wiz-bar-fill { width: 12.500%; }
  #step-2:checked ~ .wizard .wiz-bar-fill { width: 25.000%; }
  #step-3:checked ~ .wizard .wiz-bar-fill { width: 37.500%; }
  #step-4:checked ~ .wizard .wiz-bar-fill { width: 50.000%; }
  #step-5:checked ~ .wizard .wiz-bar-fill { width: 62.500%; }
  #step-6:checked ~ .wizard .wiz-bar-fill { width: 75.000%; }
  #step-7:checked ~ .wizard .wiz-bar-fill { width: 87.500%; }
  #step-8:checked ~ .wizard .wiz-bar-fill {
    width: 100%;
    background: var(--success);
  }

  /* 화면이 바뀔 때 카드 높이가 크게 출렁이지 않도록 바닥을 깔아 둔다. */
  .wiz-screens { min-height: 540px; }

  .wiz-screen { display: none; }
  #step-1:checked ~ .wizard .wiz-screen[data-step="1"],
  #step-2:checked ~ .wizard .wiz-screen[data-step="2"],
  #step-3:checked ~ .wizard .wiz-screen[data-step="3"],
  #step-4:checked ~ .wizard .wiz-screen[data-step="4"],
  #step-5:checked ~ .wizard .wiz-screen[data-step="5"],
  #step-6:checked ~ .wizard .wiz-screen[data-step="6"],
  #step-7:checked ~ .wizard .wiz-screen[data-step="7"],
  #step-8:checked ~ .wizard .wiz-screen[data-step="8"] {
    display: flex;
    flex-direction: column;
    min-height: 540px;
    animation: wizin 220ms var(--ease-out);
  }
  @keyframes wizin {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .wiz-body { flex: 1 1 auto; padding: 40px 44px 32px; }

  .wiz-kicker {
    margin: 0 0 6px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .wiz-kicker-done { color: var(--success-bright); }

  /* 한 화면에 한 가지만 말한다. 제목을 크게 두어 지금 할 일이 먼저 읽히게 한다. */
  .wiz-title {
    max-width: var(--measure);
    margin: 0 0 14px;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }
  .wiz-lead {
    max-width: var(--measure);
    margin: 0 0 24px;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-dim);
  }

  /* 도식이 주인공이다. 화면 폭을 다 쓴다. */
  .wiz-fig {
    margin: 24px 0;
    padding: 24px 26px 18px;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .wiz-fig figcaption {
    max-width: var(--measure);
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-faint);
  }

  /* 세로로 긴 사진은 폭을 묶는다. 본문 폭을 다 쓰면 원본보다 크게 늘어나
     흐려지고, 한 화면을 혼자 다 차지한다. */
  .wiz-fig-tall { max-width: 720px; }

  /* 설치 가이드 본문은 훑어 읽는 글이라 마지막 줄에 한 어절만 떨어지는
     것이 특히 눈에 띈다. 브라우저가 줄을 고르게 나누도록 맡긴다.
     지원하지 않는 브라우저에서는 기본 동작으로 떨어질 뿐 깨지지 않는다. */
  .wiz-lead,
  .wiz-fig figcaption,
  .ticks li span,
  .alt-lead,
  .dl-sub,
  .side-note,
  .spec-n {
    text-wrap: balance;
  }

  /* 마지막 화면은 할 일이 없어 내용이 짧다. 카드 높이는 단계마다 같아야
     하므로 남는 자리를 위아래로 나눠 가운데에 놓는다. 위쪽에만 몰리면
     아래가 통째로 비어 화면이 덜 만들어진 것처럼 보인다. */
  .wiz-done .wiz-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .wiz-seal {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--success) 18%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--success) 45%, transparent);
    color: var(--success-bright);
  }


  /* 단계를 넘기는 줄. 화면 바닥에 붙는다. */
  .wiz-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 44px 22px;
    border-top: 1px solid var(--border);
    background: var(--surface-sunken);
  }
  .wiz-hint { font-size: 12.5px; color: var(--text-faint); }

  .wbtn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  /* 다음으로 가는 버튼만 채운다. 어디를 눌러야 할지 헷갈리지 않게 한다. */
  .wbtn-go {
    margin-left: auto;
    background: var(--accent);
    border: 1px solid var(--accent);
    color: var(--bg);
  }
  .wbtn-go:hover { background: var(--accent-bright); border-color: var(--accent-bright); }

  .wbtn-back,
  .wbtn-ghost {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
  }
  .wbtn-back:hover,
  .wbtn-ghost:hover { color: var(--text); border-color: var(--accent); }
  .wbtn-ghost { margin-left: auto; }

  @media (prefers-reduced-motion: reduce) {
    .wiz-screen, .wiz-bar-fill, .wiz-dot, .wiz-nav label, .wbtn, .dl { transition: none; }
    #step-1:checked ~ .wizard .wiz-screen[data-step="1"],
    #step-2:checked ~ .wizard .wiz-screen[data-step="2"],
    #step-3:checked ~ .wizard .wiz-screen[data-step="3"],
    #step-4:checked ~ .wizard .wiz-screen[data-step="4"],
    #step-5:checked ~ .wizard .wiz-screen[data-step="5"],
    #step-6:checked ~ .wizard .wiz-screen[data-step="6"],
    #step-7:checked ~ .wizard .wiz-screen[data-step="7"],
    #step-8:checked ~ .wizard .wiz-screen[data-step="8"] { animation: none; }
  }

  /* 1024px 에서는 진행 표시의 글자를 지우고 동그라미만 남긴다.
     여섯 칸에 글자를 다 넣으면 잘린다. */
  @media (max-width: 1160px) {
    .wiz-nav ol { gap: 6px; }
    .wiz-dot-label { display: none; }
    .wiz-nav label { justify-content: center; }
    .wiz-body { padding: 32px 28px 26px; }
    .wiz-foot { padding: 16px 28px 20px; }
    .wiz-nav { padding: 18px 24px 0; }
    .wiz-title { font-size: 27px; }
  }

  .ticks { max-width: var(--measure); margin: 20px 0 0; padding: 0; list-style: none; }
  .ticks li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
  }
  .ticks li + li { margin-top: 10px; }
  .ticks .icon { margin-top: 5px; color: var(--accent); }
  .ticks a {
    display: inline;
    color: var(--accent-bright);
    text-underline-offset: 3px;
  }
  .ticks a .icon { margin: 0 0 -2px 2px; color: currentColor; }
