---
// 페이지 껍데기만 둔다. 탭 본문은 components/tabs/ 에 하나씩 있고,
// 화면별 스타일은 styles/ 에 갈라 두었다.
//
// 한 파일에 다 담고 있다가 3000 줄을 넘겼다. 어느 탭을 고치든 같은
// 파일을 건드리게 되고, 어떤 CSS 규칙이 어디에 쓰이는지 찾는 데만
// 시간이 들었다.

import { base } from "../lib/base-url.mjs";
import { TABS } from "../data/tabs.mjs";

// 스타일은 화면별로 갈라 둔다. 순서가 곧 우선순위다. 같은 특정도의
// 규칙은 나중 것이 이기므로, tokens 가 맨 앞, 공통 뼈대가 그다음,
// 탭별 파일이 그 뒤다.
import "../styles/tokens.css";
import "../styles/layout.css";
import "../styles/server.css";
import "../styles/playtime.css";
import "../styles/install.css";
import "../styles/trouble.css";
import "../styles/dex.css";
import "../styles/guide.css";
import "../styles/world.css";

import Sidebar from "../components/Sidebar.astro";
import Tabs from "../components/Tabs.astro";

import ServerTab from "../components/tabs/ServerTab.astro";
import ModsTab from "../components/tabs/ModsTab.astro";
import InstallTab from "../components/tabs/InstallTab.astro";
import DexTab from "../components/tabs/DexTab.astro";
import GuideTab from "../components/tabs/GuideTab.astro";
import WorldTab from "../components/tabs/WorldTab.astro";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      검색엔진 색인을 막는다. 저장소는 비공개지만 GitHub Pages 로 배포되면
      사이트 자체는 공개적으로 접근 가능해지고, 이 페이지에는 서버 접속
      주소와 비밀번호가 그대로 담겨 있다. 이 태그는 검색엔진 수집만
      막을 뿐, 주소를 이미 아는 사람의 접근을 막지는 못한다. 자세한 내용은
      docs/guides/github-pages-deploy.md 를 본다.
    -->
    <meta name="robots" content="noindex, nofollow" />

    {/* 파비콘은 base 경로를 붙여서 가리킨다. 프로젝트 Pages 라 사이트가
        /valheim-multi/ 아래에 놓이는데, 링크가 없으면 브라우저가 오리진
        루트의 /favicon.ico 를 찾다가 404 를 낸다.

        BASE_URL 은 설정에 따라 끝에 슬래시가 있을 수도 없을 수도 있다.
        그냥 이어 붙이면 /valheim-multifavicon.svg 가 된다. 실제로 겪었다. */}
    <link rel="icon" href={base("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={base("favicon.ico")} sizes="any" />

    <title>gaybar 서버</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.20/index.min.css"
    />
  </head>
  <body>
    <div class="shell">
      {TABS.map((t, i) => (
        <input
          type="radio"
          name="tab"
          id={`tab-${t.id}`}
          class="tab-radio sr-only"
          checked={i === 0}
        />
      ))}

      <Tabs tabs={TABS}>
        <ServerTab slot="server" />

        <ModsTab slot="mods" />

        <InstallTab slot="install" />

        <DexTab slot="dex" />

        <GuideTab slot="guide" />

        <WorldTab slot="world" />
      </Tabs>
      <Sidebar tabs={TABS} />
    </div>

    <script>
      import "../islands/LiveStatus.js";
      import "../islands/ItemDex.js";
      import "../islands/Guide.js";
      import "../islands/Playtime.js";
      import "../islands/ModpackFresh.js";
    </script>
  </body>
</html>
