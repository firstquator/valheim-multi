---
import "../styles/tokens.css";
import Sidebar from "../components/Sidebar.astro";
import Tabs from "../components/Tabs.astro";
import CopyField from "../components/CopyField.astro";
import Icon from "../components/Icon.astro";
import ModCard from "../components/ModCard.astro";
import Callout from "../components/Callout.astro";
import PageHead from "../components/PageHead.astro";
import DiagramFlow from "../components/diagrams/DiagramFlow.astro";
import DiagramR2modman from "../components/diagrams/DiagramR2modman.astro";
import DiagramImportCode from "../components/diagrams/DiagramImportCode.astro";
import DiagramLaunch from "../components/diagrams/DiagramLaunch.astro";
import DiagramVersion from "../components/diagrams/DiagramVersion.astro";
import { SERVER } from "../config.mjs";
import modsData from "../../../data/mods.json";

const TABS = [
  { id: "server", label: "서버", icon: "home-01" },
  { id: "mods", label: "모드", icon: "package-02" },
  { id: "install", label: "설치 가이드", icon: "download-04" },
  { id: "world", label: "월드", icon: "globe-02" },
];

const tier1 = modsData.mods.filter((m) => m.tier === 1);
const tier3 = modsData.mods.filter((m) => m.tier === 3);
const modpackCode = modsData.modpack.r2modmanCode;

// 화면 문구는 data/mods.json 의 내용에 따라 저절로 달라진다.
// 3층(직접 설치) 모드가 하나라도 있으면 "설치할 것이 있다" 로,
// 없으면 "지금은 없다" 로 읽힌다. 모드가 추가될 때 이 파일을 다시
// 고칠 필요가 없어야 한다.
const needsAnyInstall = tier3.length > 0;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      검색엔진 색인을 막는다. 저장소는 비공개지만 GitHub Pages 로 배포되면
      사이트 자체는 공개적으로 접근 가능해지고, 이 페이지에는 서버 접속
      주소와 비밀번호가 그대로 담겨 있다. 이 태그는 검색엔진 수집만
      막을 뿐, 주소를 이미 아는 사람의 접근을 막지는 못한다. 자세한 내용은
      docs/guides/github-pages-deploy.md 를 본다.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <title>gaybar 서버</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.20/index.min.css"
    />
  </head>
  <body>
    <div class="shell">
      {TABS.map((t, i) => (
        <input
          type="radio"
          name="tab"
          id={`tab-${t.id}`}
          class="tab-radio sr-only"
          checked={i === 0}
        />
      ))}

      <Tabs tabs={TABS}>
        <div slot="server">
          <PageHead
            kicker="발헤임 전용 서버"
            title="gaybar"
            icon="home-01"
            desc="주소와 비밀번호만 있으면 들어올 수 있습니다. 설치할 모드가 있는지는 모드 탭에서 확인하세요."
          >
            <div class="status-pill" slot="aside">
              <p class="badge" id="status-badge" data-state="unknown" aria-live="polite" aria-atomic="true">상태 확인 중</p>
              <p class="age" id="status-age"></p>
            </div>
          </PageHead>

          <div class="cols cols-wide">
            <section class="block">
              <h2 class="block-h">
                <Icon name="key-01" size={17} />
                접속 정보
              </h2>
              <div class="card card-lead">
                <CopyField label="주소" value={SERVER.address} mono id="server-address" />
                <CopyField label="비밀번호" value={SERVER.password} masked />
              </div>

              <h2 class="block-h block-h-gap">
                <Icon name="game-controller-01" size={17} />
                게임 안에서 접속하는 법
              </h2>
              <ol class="mini-steps">
                <li>
                  <span class="mini-n">1</span>
                  <div>
                    <strong>발헤임을 켜고 캐릭터를 고릅니다</strong>
                    <p>모드가 있는 서버라면 반드시 r2modman 의 Start modded 로 켜야 합니다.</p>
                  </div>
                </li>
                <li>
                  <span class="mini-n">2</span>
                  <div>
                    <strong>게임 참가 화면에서 서버 직접 연결을 고릅니다</strong>
                    <p>목록에서 찾지 마세요. 이 서버는 목록에 뜨지 않습니다.</p>
                  </div>
                </li>
                <li>
                  <span class="mini-n">3</span>
                  <div>
                    <strong>위 주소를 넣고 비밀번호를 칩니다</strong>
                    <p>주소는 포트 번호까지 그대로 붙여넣으면 됩니다.</p>
                  </div>
                </li>
              </ol>
            </section>

            <aside class="block">
              <h2 class="block-h">
                <Icon name="user-group" size={17} />
                지금 서버
              </h2>

              <div class="card side-card">
                <div class="side-row" id="player-wrap">
                  <span class="side-k">접속 중</span>
                  <p class="side-v" id="player-list" hidden></p>
                </div>
                <div class="side-row">
                  <span class="side-k">게임 버전</span>
                  <span class="side-v mono" id="game-version">확인 중</span>
                  <span class="side-note">클라이언트도 같은 버전이어야 접속됩니다</span>
                </div>
                <div class="side-row">
                  <span class="side-k">월드</span>
                  <span class="side-v mono">gaybar</span>
                  <span class="side-note">설정은 월드 탭에 적어 두었습니다</span>
                </div>
              </div>

              <Callout title="상태 표시가 늦을 수 있습니다" tone="info">
                서버 PC 가 1분에 한 번 상태를 올립니다. 방금 켰다면 잠시 뒤
                다시 보세요.
              </Callout>
            </aside>
          </div>
        </div>

        <div slot="mods">
          <PageHead
            kicker="이 서버에 적용된 것"
            title="모드"
            icon="package-02"
            desc="서버에만 깔리는 모드와 직접 설치해야 하는 모드를 나눠 두었습니다. 위쪽 구역만 보시면 됩니다."
          >
            <div class="count-pills" slot="aside">
              <span class="pill">
                <Icon name="package-02" size={14} />
                전체 {modsData.mods.length}개
              </span>
              <span class={`pill ${needsAnyInstall ? "pill-hot" : "pill-ok"}`}>
                <Icon name={needsAnyInstall ? "download-04" : "checkmark-circle-02"} size={14} />
                직접 설치 {tier3.length}개
              </span>
            </div>
          </PageHead>

          {needsAnyInstall ? (
            <section class="group">
              <div class="group-h">
                <h2>
                  <Icon name="download-04" size={19} />
                  직접 설치해야 하는 모드
                </h2>
                <p class="lead">
                  {tier3.length}개입니다. 설치 가이드 탭의 순서대로 하면 한 번에 끝납니다.
                </p>
              </div>

              <div class="callouts">
                <Callout title="전원이 정확히 같은 버전을 설치해야 합니다">
                  Thunderstore 에서 최신 버전을 임의로 받지 마세요. 아래 카드에 적힌
                  버전 번호를 그대로 설치해야 합니다. 한 명이라도 버전이 다르면 그
                  사람은 서버에 접속할 수 없습니다.
                </Callout>
                <Callout title="인벤토리 모드는 하나만 설치하세요">
                  ExtraSlots, EquipmentAndQuickSlots, AzuExtendedPlayerInventory 는
                  같은 코드를 건드립니다. 둘 이상 설치하면 슬롯이 늘어나는 것이 아니라
                  재접속할 때 아이템이 사라집니다.
                </Callout>
              </div>

              <div class="grid">
                {tier3.map((m) => <ModCard mod={m} />)}
              </div>
            </section>
          ) : (
            <section class="group">
              <div class="group-h group-h-ok">
                <h2>
                  <Icon name="checkmark-circle-02" size={19} />
                  직접 설치할 것은 없습니다
                </h2>
              </div>
              <Callout title="지금은 아무것도 설치하지 않아도 됩니다" tone="success">
                아래 모드는 전부 서버에만 깔려 있습니다. 그냥 발헤임을 켜고
                접속하시면 됩니다. 설치가 필요한 모드가 생기면 이 자리에
                카드로 올라옵니다.
              </Callout>
            </section>
          )}

          <section class="group">
            <div class="group-h">
              <h2>
                <Icon name="server-stack-01" size={19} />
                서버에만 깔린 모드
              </h2>
              <p class="lead">
                {tier1.length}개입니다. 접속하면 저절로 적용되니 읽고 넘기셔도 됩니다.
              </p>
            </div>
            <div class="grid">
              {tier1.map((m) => <ModCard mod={m} />)}
            </div>
          </section>
        </div>

        <div slot="install">
          <PageHead
            kicker="처음 한 번만 하면 됩니다"
            title="설치 가이드"
            icon="download-04"
            tone={needsAnyInstall ? "accent" : "success"}
            desc={needsAnyInstall
              ? "아래 순서를 위에서부터 그대로 따라 하시면 됩니다. 처음이라면 10분 정도 걸립니다."
              : "지금은 따라 할 필요가 없습니다. 앞으로 설치가 필요한 모드가 생겼을 때를 위해 적어 둡니다."}
          />

          {needsAnyInstall ? (
            <Callout title={`직접 설치해야 하는 모드가 ${tier3.length}개 있습니다`}>
              설치하지 않으면 서버에 접속할 수 없습니다. 어떤 모드인지는 모드 탭에
              적혀 있고, 아래 3단계의 프로필 코드 하나로 한꺼번에 설치됩니다.
            </Callout>
          ) : (
            <Callout title="지금 친구들은 아무것도 설치하지 않아도 접속됩니다" tone="success">
              현재 서버에는 서버에만 깔리는 모드만 있습니다. 발헤임을 그냥 켜고
              서버 탭의 주소로 들어오시면 됩니다. 아래 절차는 앞으로 직접 설치할
              모드가 추가될 때를 위한 안내입니다.
            </Callout>
          )}

          <figure class="figure figure-flat">
            <DiagramFlow />
            <figcaption>전체 흐름. 4단계만 틀리지 않으면 나머지는 쉽습니다.</figcaption>
          </figure>

          <ol class="steps">
            <li>
              <div class="step-h">
                <span class="step-n">1</span>
                <h3>r2modman 을 내려받습니다</h3>
              </div>
              <div class="step-body">
                <p>
                  모드를 프로필 단위로 관리해 주는 프로그램입니다. 게임 폴더를
                  직접 건드리지 않으므로 바닐라로 되돌리기도 쉽습니다.
                </p>
                <ul class="ticks">
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>
                      <a href="https://thunderstore.io/package/ebkr/r2modman/" target="_blank" rel="noopener noreferrer">
                        Thunderstore 의 r2modman 페이지
                        <Icon name="arrow-up-right-01" size={13} />
                        <span class="sr-only">새 탭에서 열림</span>
                      </a>
                      에서 Manual Download 를 누릅니다
                    </span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>받은 압축 파일을 풀고 안에 있는 설치 파일을 실행합니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>
                      윈도우가 알 수 없는 앱이라고 막으면 추가 정보를 누르고
                      실행을 고릅니다
                    </span>
                  </li>
                </ul>
              </div>
            </li>

            <li>
              <div class="step-h">
                <span class="step-n">2</span>
                <h3>발헤임과 Steam 을 고릅니다</h3>
              </div>
              <div class="step-body">
                <p>
                  r2modman 을 처음 켜면 게임 목록이 나옵니다. 여기서 한 번만
                  고르면 다음부터는 묻지 않습니다.
                </p>
                <ul class="ticks">
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>검색창에 Valheim 을 치고 목록에서 고른 뒤 Select game 을 누릅니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>플랫폼을 묻는 화면에서 Steam 을 고릅니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>
                      게임 폴더를 못 찾는다고 하면 Settings 의 Locations 에서
                      발헤임 설치 폴더를 직접 지정합니다
                    </span>
                  </li>
                </ul>
              </div>
            </li>

            <li>
              <div class="step-h">
                <span class="step-n">3</span>
                <h3>프로필 코드를 가져옵니다</h3>
              </div>
              <div class="step-body">
                <p>
                  모드를 하나씩 찾아서 받을 필요가 없습니다. 코드 한 줄이면
                  목록과 버전이 통째로 맞춰집니다.
                </p>

                <figure class="figure">
                  <DiagramR2modman />
                  <figcaption>
                    r2modman 창의 구조입니다. 왼쪽이 프로필, 오른쪽 위가
                    Import / Update, 왼쪽 아래가 실행 버튼입니다.
                  </figcaption>
                </figure>

                <ul class="ticks">
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>프로필 화면에서 Import / Update 를 누릅니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>코드로 가져오기를 고르고 아래 코드를 붙여넣습니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>
                      프로필 이름을 정하고 확인을 누르면 모드가 자동으로
                      내려받아집니다. 끝날 때까지 기다립니다
                    </span>
                  </li>
                </ul>

                {modpackCode ? (
                  <div class="card code-card">
                    <CopyField label="프로필 코드" value={modpackCode} mono />
                  </div>
                ) : (
                  <div class="pending-box">
                    <Icon name="clock-01" size={16} />
                    <span>
                      프로필 코드는 직접 설치할 모드가 정해지면 이 자리에
                      올라옵니다. 지금은 비워 둡니다.
                    </span>
                  </div>
                )}

                <figure class="figure">
                  <DiagramImportCode />
                  <figcaption>코드를 붙여넣는 자리와 순서입니다.</figcaption>
                </figure>
              </div>
            </li>

            <li>
              <div class="step-h">
                <span class="step-n">4</span>
                <h3>Start modded 로 게임을 켭니다</h3>
              </div>
              <div class="step-body">
                <p>
                  여기서 가장 많이 틀립니다. 습관대로 Steam 에서 켜면 모드가
                  하나도 적용되지 않고, 그 상태로는 서버에 못 들어옵니다.
                </p>

                <Callout title="Steam 에서 직접 켜면 모드가 적용되지 않습니다">
                  Steam 라이브러리의 플레이 버튼은 모드 없는 바닐라 게임을
                  켭니다. 반드시 r2modman 왼쪽 위의 Start modded 를 누르세요.
                  바탕화면 바로가기를 만들어 두면 편합니다.
                </Callout>

                <figure class="figure">
                  <DiagramLaunch />
                  <figcaption>
                    같은 게임이라도 어디서 켜느냐에 따라 결과가 달라집니다.
                  </figcaption>
                </figure>

                <ul class="ticks">
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>방금 만든 프로필이 골라져 있는지 확인합니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>
                      첫 실행은 모드 로더를 까느라 평소보다 오래 걸립니다.
                      검은 화면이 좀 길어도 기다립니다
                    </span>
                  </li>
                </ul>
              </div>
            </li>

            <li>
              <div class="step-h">
                <span class="step-n">5</span>
                <h3>서버에 들어옵니다</h3>
              </div>
              <div class="step-body">
                <p>
                  캐릭터를 고르고 게임 참가 화면에서 서버 직접 연결을 누른 뒤,
                  서버 탭에 적힌 주소와 비밀번호를 넣습니다. 이 서버는 공개
                  목록에 뜨지 않으니 목록에서 찾지 마세요.
                </p>
                <ul class="ticks">
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>주소는 포트 번호까지 통째로 붙여넣습니다</span>
                  </li>
                  <li>
                    <Icon name="arrow-right-02" size={15} />
                    <span>비밀번호는 접속할 때마다 묻지 않습니다. 처음 한 번만 칩니다</span>
                  </li>
                </ul>
              </div>
            </li>
          </ol>

          <section class="group trouble">
            <div class="group-h">
              <h2>
                <Icon name="help-circle" size={19} />
                잘 안 될 때
              </h2>
              <p class="lead">막히는 자리는 대개 정해져 있습니다.</p>
            </div>

            <div class="qa-grid">
              <article class="qa">
                <h3>
                  <Icon name="alert-02" size={16} />
                  접속하려는데 거부당합니다
                </h3>
                <p>
                  모드 목록이나 버전이 서버와 다릅니다. 모드 탭의 카드에 적힌
                  버전과 r2modman 에 깔린 버전이 같은지 하나씩 맞춰 보세요.
                  최신 버전이 아니라 적힌 버전이어야 합니다.
                </p>
              </article>

              <article class="qa">
                <h3>
                  <Icon name="alert-02" size={16} />
                  분명히 설치했는데 모드가 안 보입니다
                </h3>
                <p>
                  Steam 에서 켰을 가능성이 큽니다. 게임을 끄고 r2modman 의
                  Start modded 로 다시 켜 보세요.
