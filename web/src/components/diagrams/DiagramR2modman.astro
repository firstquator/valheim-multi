---
// r2modman 창의 구조를 단순하게 그린 도식이다.
// 스크린샷 대신 그리는 이유는 프로그램 버전이 올라가면 스크린샷은
// 틀린 그림이 되지만, 이 정도로 단순화한 배치는 잘 변하지 않기 때문이다.
---

<svg
  class="dg"
  viewBox="0 0 900 400"
  role="img"
  aria-labelledby="dg-r2-title dg-r2-desc"
>
  <title id="dg-r2-title">r2modman 창의 구조</title>
  <desc id="dg-r2-desc">
    왼쪽에 프로필 목록, 그 아래에 Start modded 버튼, 오른쪽 위에 Import
    Update 버튼, 그 아래에 설치된 모드 목록이 놓인 창입니다.
  </desc>

  <!-- 창 바깥 테두리 -->
  <rect x="16" y="30" width="580" height="340" rx="12" fill="var(--surface)" stroke="var(--border)" />

  <!-- 제목 표시줄 -->
  <path
    d="M16 42a12 12 0 0 1 12-12h556a12 12 0 0 1 12 12v22H16z"
    fill="var(--surface-raised)"
  />
  <line x1="16" y1="64" x2="596" y2="64" stroke="var(--border)" />
  <circle cx="34" cy="47" r="4" fill="var(--border-strong)" />
  <circle cx="48" cy="47" r="4" fill="var(--border-strong)" />
  <circle cx="62" cy="47" r="4" fill="var(--border-strong)" />
  <text class="t-win" x="80" y="51">r2modman</text>

  <!-- 왼쪽 프로필 패널 -->
  <rect x="16" y="64" width="176" height="306" fill="var(--surface-sunken)" />
  <line x1="192" y1="64" x2="192" y2="370" stroke="var(--border)" />
  <text class="t-sec" x="34" y="92">프로필</text>

  <rect x="32" y="104" width="144" height="28" rx="6" fill="var(--surface-raised)" stroke="var(--accent)" />
  <circle cx="46" cy="118" r="4" fill="var(--accent)" />
  <text class="t-row t-on" x="58" y="122">gaybar</text>

  <rect x="32" y="140" width="144" height="28" rx="6" fill="var(--surface-raised)" stroke="var(--border)" />
  <rect x="42" y="152" width="70" height="5" rx="2.5" fill="var(--text-faint)" />

  <rect x="32" y="176" width="144" height="28" rx="6" fill="var(--surface-raised)" stroke="var(--border)" />
  <rect x="42" y="188" width="52" height="5" rx="2.5" fill="var(--text-faint)" />

  <!-- Start modded 버튼 -->
  <rect x="32" y="320" width="144" height="34" rx="8" fill="var(--accent)" />
  <path d="M52 337l-8-5v10z" fill="var(--bg)" />
  <text class="t-btn" x="66" y="342">Start modded</text>

  <!-- 오른쪽 도구 모음 -->
  <rect x="210" y="84" width="140" height="30" rx="7" fill="var(--surface-raised)" stroke="var(--accent)" />
  <text class="t-row t-on" x="226" y="103">Import / Update</text>

  <rect x="362" y="84" width="92" height="30" rx="7" fill="var(--surface-raised)" stroke="var(--border)" />
  <rect x="378" y="96" width="60" height="5" rx="2.5" fill="var(--text-faint)" />

  <!-- 설치된 모드 목록 -->
  <text class="t-sec" x="210" y="146">설치된 모드</text>
  <g>
    <rect x="210" y="158" width="368" height="32" rx="7" fill="var(--surface-sunken)" stroke="var(--border)" />
    <circle cx="230" cy="174" r="7" fill="var(--border-strong)" />
    <rect x="246" y="167" width="120" height="6" rx="3" fill="var(--text-dim)" />
    <rect x="246" y="178" width="200" height="5" rx="2.5" fill="var(--text-faint)" />

    <rect x="210" y="198" width="368" height="32" rx="7" fill="var(--surface-sunken)" stroke="var(--border)" />
    <circle cx="230" cy="214" r="7" fill="var(--border-strong)" />
    <rect x="246" y="207" width="96" height="6" rx="3" fill="var(--text-dim)" />
    <rect x="246" y="218" width="168" height="5" rx="2.5" fill="var(--text-faint)" />

    <rect x="210" y="238" width="368" height="32" rx="7" fill="var(--surface-sunken)" stroke="var(--border)" />
    <circle cx="230" cy="254" r="7" fill="var(--border-strong)" />
    <rect x="246" y="247" width="140" height="6" rx="3" fill="var(--text-dim)" />
    <rect x="246" y="258" width="180" height="5" rx="2.5" fill="var(--text-faint)" />

    <rect x="210" y="278" width="368" height="32" rx="7" fill="var(--surface-sunken)" stroke="var(--border)" />
    <circle cx="230" cy="294" r="7" fill="var(--border-strong)" />
    <rect x="246" y="287" width="110" height="6" rx="3" fill="var(--text-dim)" />
    <rect x="246" y="298" width="150" height="5" rx="2.5" fill="var(--text-faint)" />
  </g>

  <!-- 번호 표식. 오른쪽 설명과 이어진다. -->
  <g>
    <line x1="176" y1="118" x2="632" y2="86" stroke="var(--border-strong)" stroke-dasharray="3 4" />
    <circle cx="176" cy="118" r="12" fill="var(--accent)" />
    <text class="t-num" x="176" y="123">1</text>

    <line x1="350" y1="99" x2="632" y2="152" stroke="var(--border-strong)" stroke-dasharray="3 4" />
    <circle cx="350" cy="99" r="12" fill="var(--accent)" />
    <text class="t-num" x="350" y="104">2</text>

    <line x1="176" y1="337" x2="632" y2="252" stroke="var(--border-strong)" stroke-dasharray="3 4" />
    <circle cx="176" cy="337" r="12" fill="var(--accent)" />
    <text class="t-num" x="176" y="342">3</text>
  </g>

  <!-- 오른쪽 설명 -->
  <g>
    <text class="t-lead" x="632" y="80">프로필 목록</text>
    <text class="t-sub" x="632" y="102">서버용 프로필을 여기서 고릅니다</text>

    <text class="t-lead" x="632" y="146">Import / Update</text>
    <text class="t-sub" x="632" y="168">아래 3단계에서 코드를 넣는 버튼</text>

    <text class="t-lead" x="632" y="246">Start modded</text>
    <text class="t-sub" x="632" y="268">반드시 이 버튼으로 게임을 켭니다</text>
  </g>
</svg>

<style>
  .dg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }
  text { dominant-baseline: auto; }
  .t-win { font-size: 13px; fill: var(--text-dim); }
  .t-sec { font-size: 12px; font-weight: 600; fill: var(--text-faint); letter-spacing: 0.04em; }
  .t-row { font-size: 13px; fill: var(--text-dim); }
  .t-on { fill: var(--accent-bright); font-weight: 600; }
  .t-btn { font-size: 13px; font-weight: 700; fill: var(--bg); }
  .t-num { font-size: 13px; font-weight: 700; fill: var(--bg); text-anchor: middle; }
  .t-lead { font-size: 15px; font-weight: 700; fill: var(--text); }
  .t-sub { font-size: 13px; fill: var(--text-dim); }
</style>
