---
// Import / Update 를 누른 뒤 나오는 대화상자에서 프로필 코드를 어디에
// 붙여넣는지 보여주는 도식이다. 이 자리를 못 찾아서 막히는 경우가 많다.
---

<svg
  class="dg"
  viewBox="0 0 900 340"
  role="img"
  aria-labelledby="dg-imp-title dg-imp-desc"
>
  <title id="dg-imp-title">프로필 코드를 붙여넣는 자리</title>
  <desc id="dg-imp-desc">
    프로필 가져오기 대화상자에서 코드로 가져오기를 고른 다음, 가운데 입력칸에
    복사한 코드를 붙여넣고 아래 가져오기 버튼을 누릅니다.
  </desc>

  <!-- 왼쪽: 복사한 코드 조각 -->
  <rect x="16" y="120" width="190" height="70" rx="10"
        fill="var(--surface-raised)" stroke="var(--accent)" stroke-dasharray="5 4" />
  <text class="t-sub" x="32" y="146">이 페이지에서 복사한 코드</text>
  <rect x="32" y="158" width="150" height="8" rx="4" fill="var(--accent)" />

  <!-- 연결 화살표 -->
  <line x1="212" y1="155" x2="272" y2="155" stroke="var(--accent)" stroke-width="2" />
  <path d="M286 155l-14-7v14z" fill="var(--accent)" />

  <!-- 대화상자 -->
  <rect x="300" y="34" width="440" height="272" rx="12"
        fill="var(--surface)" stroke="var(--border-strong)" />
  <text class="t-title" x="326" y="72">프로필 가져오기</text>
  <line x1="300" y1="88" x2="740" y2="88" stroke="var(--border)" />

  <!-- 두 가지 선택지 -->
  <rect x="326" y="104" width="180" height="36" rx="8"
        fill="var(--surface-raised)" stroke="var(--accent)" />
  <circle cx="346" cy="122" r="7" fill="none" stroke="var(--accent)" stroke-width="2" />
  <circle cx="346" cy="122" r="3.5" fill="var(--accent)" />
  <text class="t-row t-on" x="362" y="127">코드로 가져오기</text>

  <rect x="518" y="104" width="196" height="36" rx="8"
        fill="var(--surface-sunken)" stroke="var(--border)" />
  <circle cx="538" cy="122" r="7" fill="none" stroke="var(--text-faint)" stroke-width="2" />
  <text class="t-row" x="554" y="127">파일로 가져오기</text>

  <!-- 코드 입력칸 -->
  <rect x="326" y="164" width="388" height="46" rx="8"
        fill="var(--surface-sunken)" stroke="var(--accent)" stroke-width="2" />
  <text class="t-code" x="344" y="193">여기에 붙여넣습니다</text>
  <rect x="330" y="176" width="2" height="22" fill="var(--accent)" />

  <!-- 붙여넣기 단축키 -->
  <rect x="326" y="224" width="46" height="26" rx="6" fill="var(--surface-raised)" stroke="var(--border-strong)" />
  <text class="t-key" x="349" y="242">Ctrl</text>
  <text class="t-plus" x="382" y="242">+</text>
  <rect x="394" y="224" width="32" height="26" rx="6" fill="var(--surface-raised)" stroke="var(--border-strong)" />
  <text class="t-key" x="410" y="242">V</text>
  <text class="t-sub" x="440" y="242">로 붙여넣으면 됩니다</text>

  <!-- 확인 버튼 -->
  <rect x="592" y="256" width="122" height="34" rx="8" fill="var(--accent)" />
  <text class="t-btn" x="653" y="278">가져오기</text>

  <!-- 오른쪽 주의 문구 -->
  <rect x="760" y="120" width="130" height="86" rx="10"
        fill="var(--surface)" stroke="var(--border)" />
  <circle cx="784" cy="146" r="10" fill="var(--warning)" />
  <text class="t-num" x="784" y="151">!</text>
  <text class="t-sub" x="778" y="180">코드 앞뒤에</text>
  <text class="t-sub" x="778" y="197">공백이 없게</text>
</svg>

<style>
  .dg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }
  .t-title { font-size: 17px; font-weight: 700; fill: var(--text); }
  .t-row { font-size: 13.5px; fill: var(--text-dim); }
  .t-on { fill: var(--accent-bright); font-weight: 600; }
  .t-sub { font-size: 13px; fill: var(--text-dim); }
  /* 안내 문구는 한글이라 모노를 쓰지 않는다. Ctrl 과 V 만 모노다. */
  .t-code { font-size: 14px; fill: var(--text-faint); }
  .t-key { font-family: var(--font-mono); font-size: 12px; fill: var(--text-dim); text-anchor: middle; }
  .t-plus { font-size: 14px; fill: var(--text-faint); text-anchor: middle; }
  .t-btn { font-size: 14px; font-weight: 700; fill: var(--bg); text-anchor: middle; }
  .t-num { font-size: 13px; font-weight: 700; fill: var(--bg); text-anchor: middle; }
</style>
