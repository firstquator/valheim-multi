---
import { readIcon } from "../lib/icon.mjs";

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: klass = "", label } = Astro.props;
const svg = readIcon(name, { label });
---

<span class={`icon ${klass}`} style={`--icon-size:${size}px`} set:html={svg} />

<style>
  .icon {
    display: inline-flex;
    width: var(--icon-size);
    height: var(--icon-size);
    flex: none;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }
</style>
