---
// 도감 탭. 실제 내용은 islands/ItemDex.js 가 그린다. 아이템이 1000 개가
// 넘어 정적 마크업으로는 감당이 안 된다.
//
// index.astro 가 <DexTab slot="dex" /> 로 끼운다.

import Icon from "../Icon.astro";
import PageHead from "../PageHead.astro";
---

<div>
<PageHead
  kicker="게임에 있는 것 전부"
  title="도감"
  icon="book-open-01"
  desc="이름으로 찾거나 진행 단계로 좁혀 보세요. 아이템을 누르면 능력치가 무슨 뜻인지, 무엇으로 만드는지, 강화에 뭐가 드는지까지 나옵니다."
>
  <div class="count-pills" slot="aside">
    <span class="pill">
      <Icon name="package-02" size={14} />
      <span id="dex-count">불러오는 중</span>
    </span>
  </div>
</PageHead>

{/*
  이 탭만 자바스크립트로 그린다. 아이템이 1000 개가 넘어
  정적 마크업으로 만들면 HTML 이 수 메가가 되고, 검색과
  걸러내기도 할 수 없다. 데이터는 public/items.json 에서
  받아 온다.

  이름과 설명은 게임 파일에 들어 있는 공식 한국어다.
  손으로 옮기지 않았으므로 게임 안에서 보는 말과 같다.
*/}
<div class="dex-tools">
  <label class="dex-search">
    <Icon name="search-01" size={18} />
    <input
      type="search"
      id="dex-q"
      placeholder="이름으로 찾기 (한국어, 영어 모두 됩니다)"
      autocomplete="off"
    />
  </label>
  <div class="dex-filter">
    <span class="dex-f-label">진행 단계</span>
    <div class="dex-chips" id="dex-stages"></div>
  </div>
  <div class="dex-filter">
    <span class="dex-f-label">종류</span>
    <div class="dex-chips" id="dex-groups"></div>
  </div>
  {/*
    정렬. "늪 단계에서 가장 센 무기" 를 찾으려면 눈으로 훑는
    수밖에 없었다. 걸러내기와 달리 언제나 하나가 켜져 있다.
  */}
  <div class="dex-filter">
    <span class="dex-f-label">정렬</span>
    <div class="dex-chips" id="dex-sorts"></div>
  </div>
  {/*
    단계 이름만 보여주면 순서를 모른다. "늪" 이 언제 갈 만한
    곳인지는 보스 이름과 함께 놓아야 읽힌다.
  */}
  <p class="dex-note" id="dex-note" hidden></p>
</div>

<div class="dex-grid" id="dex-grid">
  <p class="dex-empty">아이템 정보를 불러오는 중입니다.</p>
</div>

<div class="dex-modal" id="dex-modal" hidden>
  <div class="dex-panel" id="dex-panel" role="dialog" aria-modal="true" aria-label="아이템 상세">
    <div class="dex-panel-top">
      {/*
        재료를 눌러 다른 아이템으로 건너뛸 수 있어서, 되돌아올
        길이 필요하다. 건너뛴 적이 없으면 숨어 있는다.
      */}
      <button class="dex-back" id="dex-back" type="button" hidden>
        <Icon name="arrow-left-01" size={16} />
        뒤로
      </button>
      <button class="dex-close" id="dex-close" type="button" aria-label="닫기">
        <Icon name="cancel-01" size={18} />
      </button>
    </div>
    <div id="dex-detail"></div>
  </div>
</div>
</div>
