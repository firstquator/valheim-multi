# 이 파일을 agent/.env 로 복사한 뒤 값을 채운다.
# .env 는 gitignore 대상이다. 토큰이 들어가므로 커밋하지 않는다.
#
# 실행할 때 이 파일을 불러오려면 node 의 내장 옵션을 쓴다.
#   node --env-file=agent/.env agent/status-publisher.mjs
# (Node 20.6 이상에서 지원한다. 이 프로젝트는 Node 22.12 이상을 요구하므로
#  별도 패키지 없이 바로 쓸 수 있다.)
#
# 발급 절차 전체는 docs/guides/status-publisher-setup.md 를 본다.

# Gist 를 갱신할 권한을 가진 GitHub Personal Access Token.
# https://github.com/settings/tokens 에서 Fine-grained token 으로 발급한다.
# 권한은 Gists: Read and write 하나만 준다. 저장소 권한은 주지 않는다.
GIST_TOKEN=여기에_발급받은_토큰

# 상태를 올릴 대상 Gist 의 id.
# https://gist.github.com 에서 시크릿 Gist 를 만든 뒤,
# 그 페이지 URL 마지막 32자리가 Gist id 다.
GIST_ID=여기에_gist_id

# 아래는 선택 항목이다. 비워두거나 지우면 기본값을 쓴다.

# 백업 폴더 위치. 기본값이 실제 서버 설정(C:/ValheimServer/backups)과
# 이미 일치하므로 보통 건드릴 필요 없다.
# BACKUP_DIR=C:/ValheimServer/backups

# 갱신 주기(초). 기본값 30.
# INTERVAL_SEC=30

# 연속 실패 허용 횟수. 이 횟수를 넘기면 프로세스가 종료 코드 1로 종료된다.
# 작업 스케줄러가 재시작하도록 설정해뒀다면 그대로 둬도 된다. 기본값 20.
# MAX_CONSECUTIVE_FAILURES=20
