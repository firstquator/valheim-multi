# 이 파일을 server/.env 로 복사한 뒤 값을 채운다.
# .env 는 gitignore 대상이다. 비밀번호가 들어가므로 커밋하지 않는다.

# Steam 서버 목록에 표시될 이름
SERVER_NAME=바꿀것

# 월드 이름. 친구에게 받은 월드는 gaybar 다.
# 대소문자까지 정확해야 한다. 틀리면 서버가 에러를 내지 않고
# 그 이름으로 빈 월드를 새로 만든다.
WORLD_NAME=gaybar

# 접속 비밀번호
#   - 최소 5자 이상
#   - 서버 이름이나 월드 이름에 포함된 문자열은 쓸 수 없다
#     (월드가 gaybar 이므로 gaybar 가 들어간 비밀번호는 거부된다)
SERVER_PASS=바꿀것

# 관리자 권한을 줄 Steam ID (SteamID64). 공백으로 구분한다.
# 비워두면 아무도 관리자 명령을 쓸 수 없다.
ADMINLIST_IDS=

# 백업을 내보낼 Windows 폴더.
# Docker Desktop 이 접근할 수 있는 경로여야 한다.
# 비워두면 server/backups 에 쌓인다.
BACKUP_HOST_DIR=C:/ValheimServer/backups
